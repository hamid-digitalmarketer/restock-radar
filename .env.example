# Restock Radar - Shopify App Configuration

## shopify.app.toml

```toml
name = "restock-radar"
version = "1.0.0"
description = "Back-in-Stock & Preorder Recovery App for Shopify"
author = "Hamid <hamid@digitalmarketer.com>"

[build]
  command = "npm run build"
  directory = "app/build"

[deploy]
  target = "heroku"
  domain = "restock-radar.example.com"
  # This will be configured during deployment
```

## .env.example

```env
# Shopify API credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_APP_SHOPIFY_EMAIL=admin@yourstore.com

# Database
DATABASE_URL="file:./dev.db"

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# SMS (Twilio)
TWILIO_API_KEY=your_twilio_api_key
TWILIO_PHONE_NUMBER=+1234567890

# App settings
INCLUDE_BRANDING=true
PLAN="free"

# Security
SESSION_COOKIE_NAME=restock_radar_session
SESSION_COOKIE_DOMAIN=.yourstore.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict
SESSION_COOKIE_HTTPONLY=true

# Debugging
LOG_LEVEL=info
DEBUG=true